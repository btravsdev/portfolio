---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import SkillsSection from '../components/home/SkillsSection.astro';
import WorkSection from '../components/home/WorkSection.astro';
import VideoSection from '../components/home/VideoSection.astro';
import ContactSection from '../components/home/ContactSection.astro';
import '../styles/displayads.css';
---

<Layout title="Brian Travers is a front-end developer" pageId="home" bodyId="home" bodyClass="front-page">
  <Hero />
  <main class="site-main site-main__home">
    <WorkSection />
    <SkillsSection />
    <VideoSection />
    <ContactSection />
  </main>

  <script src="../scripts/displayads.js"></script>
</Layout>
