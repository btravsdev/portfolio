---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import StickyNav from '../components/StickyNav.astro';
import PlaylistSection from '../components/home/PlaylistSection.astro';
import { roles } from '../data/roles';

const role = roles.deejay;
---

<Layout title={role.title} pageId="deejay" bodyId="deejay" bodyClass="front-page is-a__page">
  <Hero role="deejay" />
  <StickyNav />
  <main class="site-main site-main__home">
    <PlaylistSection />
  </main>
</Layout>
