---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Brian Travers" pageId="colophon">
  <div id="colophon-wrapper" class="colophon-wrapper gridder">
    <header class="site-header section">
      <h1 class="colophon__title title">
        Colophon
      </h1>
      <div class="intro">
        <p class=""> A list of the items that helped me put this website together. Partly to give credit to these fantastic resources for web development, but also so I have a reference for myself for where I in the future.</p>
      </div>
    </header>
    <main class="colophon__site-main site-main">

      <h2 class="section-hdr">Links</h2>

      <div class="credit-sets">
        <div class="credit-set">
          <h3 class="credit-set-hdr">Design:</h3>
          <ul class="credit-list">
            <li>
              Color Palette - <a class="text_small" href="https://stuartspixelgames.com/2018/07/15/retro-game-colour-palettes-and-tools/">https://stuartspixelgames.com/2018/07/15/retro-game-colour-palettes-and-tools/</a>
            </li>
          </ul>
        </div>

        <div class="credit-set">
          <h3 class="credit-set-hdr">CSS:</h3>
          <ul class="credit-list">
            <li>
              Type scale - <a class="text_small" href="https://type-scale.com/">https://type-scale.com/</a>
            </li>
            <li>
              CSS Tricks guide to flexbox - <a class="text_small" href="https://css-tricks.com/snippets/css/a-guide-to-flexbox/">https://css-tricks.com/snippets/css/a-guide-to-flexbox/</a>
            </li>
            <li>
              CSS Tricks guide to CSS Grid - <a class="text_small" href="https://css-tricks.com/snippets/css/complete-guide-grid/">https://css-tricks.com/snippets/css/complete-guide-grid/</a>
            </li>
            <li>CSS variables - <a class="text_small" href="https://lukelowrey.com/css-variable-theme-switcher/">https://lukelowrey.com/css-variable-theme-switcher/</a></li>
          </ul>
        </div>
      </div>

      <div class="credit-set">
        <h3 class="credit-set-hdr">Animation</h3>
        <ul class="credit-list">
          <li>
            Greensock - <a class="text_small" href="https://greensock.com/">https://greensock.com/</a>
          </li>
          <li>
            Greensock Tips - <a class="text_small" href="https://css-tricks.com/tips-for-writing-animation-code-efficiently/">https://css-tricks.com/tips-for-writing-animation-code-efficiently/</a>
          </li>
        </ul>
      </div>


      <!-- <section id="contact" class="section section-contact gridder">
        <div class="leftside-wrapper">
          <h2>You can reach me&nbsp;at:</h2>
        </div>
        <div class="strongside-wrapper contact-info">
          <ul class="list-reset contact-items">
            <li>773-726-3263</li>
            <li><a href="mailto:holler@briantravers.com">holler@briantravers.com</a></li>
          </ul>
        </div>
      </section> -->
    </main>
  </div>
</Layout>
