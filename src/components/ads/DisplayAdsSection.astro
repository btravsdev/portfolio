---
import NsAd from './NsAd.astro';
import GcfdAd from './GcfdAd.astro';
import CefcuAd from './CefcuAd.astro';
import OrthoAd from './OrthoAd.astro';
---

<article id="display-ads" class="work-item gridder">
  <div class="">
    <h3 class="work-hdr">Display Ads</h3>
    <p><strong>Description:</strong> I like to think of display ads as quick static websites with subtle yet eye-catching animations with libraries like Greensock, SVGs and CSS. After years of building with Adobe Flash and others, I now hand-code each&nbsp;ad.</p>
    <p><strong>Highlight:</strong> Banners need to be seen by everyone, so extra attention needs to be spent on browser support (even&nbsp;IE11!).</p>
  </div>
  <div class="work-displayads">
    <NsAd />
    <GcfdAd />
    <CefcuAd />
    <OrthoAd />
  </div>
</article>
