---
import NsAd from './NsAd.astro';
import GcfdAd from './GcfdAd.astro';
import CefcuAd from './CefcuAd.astro';
import OrthoAd from './OrthoAd.astro';
import '../../styles/displayads.css';
---

<article id="display-ads" class="work-item work-item--displayads" data-reveal="work-item">
  <div class="work-displayads" data-reveal="work-video">
    <NsAd />
    <GcfdAd />
    <CefcuAd />
    <OrthoAd />
  </div>
  <div class="work-displayads-content work-item__content" data-reveal="work-content">
    <h3 class="work-hdr">Display Ads</h3>
    <p class="work-item__description">Display advertising taught me to appreciate the details of front-end engineering long before modern frameworks. Every animation, transition, and kilobyte matters when you're working within strict file-size and browser compatibility constraints. That experience continues to influence how I approach performance, accessibility, and polished user interactions today.</p>
    <ul class="work-tags list-reset" aria-label="Project tags">
      <li class="work-tag">JavaScript</li>
      <li class="work-tag">GSAP</li>
      <li class="work-tag">Animation</li>
    </ul>
  </div>
</article>

<script>
  import '../../scripts/displayads.js';
</script>

<style lang="scss" is:global>
@use '../../styles/breakpoints.scss' as *;

.work-item--displayads {
  display: flex;
  flex-direction: column;
  gap: var(--gap);
  @include at-least(md) {
    display: grid;
    grid-template-columns: var(--max-width-focus) 1fr;
    gap: var(--gap);
  }
}
.work-displayads {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--gap);
}

.work-displayad--wrapper {
  width: 100%;
  height: 0;
  position: relative;
  padding-top: calc((250 / 300) * 100%);

  iframe {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
}
</style>
