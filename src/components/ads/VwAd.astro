---
const uid = `vw${Math.random().toString(36).slice(2, 8)}`;
---

<script>
  import { gsap } from 'gsap';

  const cleanups = new Map();

  function mount(root: HTMLElement) {
    const select = gsap.utils.selector(root);
    // Attribute selectors, not #id. Duplicate ids are shared by both ads on the page,
    // and querySelector('#id') only resolves the first one in the document.
    const q = (selector: string) => select(selector.replace(/#([\w-]+)/g, '[id="$1"]'));
    const running = new Map();
    const ac = new AbortController();

    function track(key: string, create: () => GSAPTimeline) {
      running.get(key)?.kill();
      const tl = create();
      running.set(key, tl);
      return tl;
    }

    // Side timelines are not children of the master, so a repeat leaves the
    // burst at its end state (opacity 0, rays scaled, wrapper offset) and the
    // next play never becomes visible. Put it back to the SVG's starting point.
    function resetBurst() {
      const parts = q('#burst-wrapper, #burst, #burst-top, #burst-bottom, #burst-right, #burst-left');
      gsap.killTweensOf(parts);
      gsap.set(parts, { clearProps: 'transform' });
      gsap.set(q('#burst'), { opacity: 0, scale: 1 });
    }

    function animate_thatsAllFolks(txtNum: number) {
      const circles = [1, 2, 3, 4].flatMap((n) => Array.from(q(`.txt${txtNum}-circle-${n}`)));
      return gsap.timeline()
        .set(q(`#svg-txt${txtNum}-circles`), { opacity: 1 })
        .from(q(`#txt${txtNum}-all-circles`), { y: 100, duration: 1, ease: 'back.out(1.7)' }, 0)
        .from(circles, {
          attr: { r: 0 },
          y: 10,
          duration: 0.8,
          stagger: 0.02,
          ease: 'back.out(1)',
          modifiers: { r: (value: number) => Math.max(0, value) },
        }, 0);
    }

    function animate_removeThatsAllFolks(txtNum: number) {
      const circles = [1, 2, 3, 4].flatMap((n) => Array.from(q(`.txt${txtNum}-circle-${n}`)));
      return gsap.timeline()
        .to(q(`#txt${txtNum}-all-circles`), { y: 100, duration: 0.8, ease: 'back.out(1.7)' }, 0)
        .to(circles, {
          attr: { r: 0 },
          y: 10,
          duration: 0.8,
          stagger: 0.02,
          ease: 'back.out(1)',
          modifiers: { r: (value: number) => Math.max(0, value) },
        }, 0);
    }

    function animate_burst(yPos: number, xPos: number) {
      return gsap.timeline({ defaults: { duration: 0.75, ease: 'power4.out' } })
        .set(q('#burst-wrapper'), { y: yPos, x: xPos })
        .set(q('#burst'), { opacity: 1, scale: 0 })
        .set(q('#burst-top'), { svgOrigin: '250 182', scaleY: 0 })
        .set(q('#burst-bottom'), { svgOrigin: '250 318', scaleY: 0 })
        .set(q('#burst-right'), { svgOrigin: '318 250', scaleX: 0 })
        .set(q('#burst-left'), { svgOrigin: '182 250', scaleX: 0 })
        .to(q('#burst'), { scale: 1, opacity: 1 }, 'start')
        .to(q('#burst-top'), { scaleY: 1, duration: 1.5 }, 'start+=0.05')
        .to(q('#burst-bottom'), { scaleY: 1, duration: 1.5 }, 'start+=0.05')
        .to(q('#burst-right'), { scaleX: 1, duration: 1.5 }, 'start+=0.05')
        .to(q('#burst-left'), { scaleX: 1, duration: 1.5 }, 'start+=0.05')
        .to(q('#burst'), { scale: 0, opacity: 0 }, 'start+=1.25');
    }

    function frame1() {
      const tl = gsap.timeline({ defaults: { duration: 0.75, ease: 'power1.inOut' } });
      tl
        .set(q('.fromTop'), { y: 40, opacity: 1 })
        .set(q('#txt1a'), { svgOrigin: '27 44' })
        .call(() => track('folks-1', () => animate_thatsAllFolks(1)), [], 'txt1')
        .to(q('#logo'), { opacity: 1, duration: 0.5 }, 'txt1')
        .to(q('#txt1a'), { y: 0 }, 'txt1+=0.25')
        .to(q('#txt1b'), { y: 0 }, 'txt1+=0.75')
        .to(q('#txt1c'), { opacity: 1 }, 'txt1+=1')
        .call(() => track('burst-1a', () => animate_burst(72, -26)))
        .call(() => track('burst-1b', () => animate_burst(105, 146)));
      return tl;
    }

    function frame2() {
      const tl = gsap.timeline({ defaults: { duration: 0.75, ease: 'power1.inOut' } });
      tl
        .to(q('#txt1b'), { opacity: 0 }, 'txt2')
        .to(q('#logo'), { opacity: 0 }, 'txt2+=0.15')
        .to(q('#txt1c'), { opacity: 0 }, 'txt2+=0.3')
        .call(() => track('folks-1-out', () => animate_removeThatsAllFolks(1)), [], 'txt2+=0.5')
        .call(() => track('folks-2', () => animate_thatsAllFolks(2)), [], 'txt2+=1.5')
        .to(q('#txt2b'), { y: 0 }, 'txt2+=1.25')
        .call(() => track('burst-2a', () => animate_burst(61, -46)))
        .call(() => track('burst-2b', () => animate_burst(156, 179)));
      return tl;
    }

    function frame3() {
      const tl = gsap.timeline({ defaults: { duration: 0.75, ease: 'power1.inOut' } });
      tl
        .call(() => track('folks-2-out', () => animate_removeThatsAllFolks(2)), [], 'start')
        .to(q('#txt2'), { opacity: 0 }, 'start')
        .to(q('#img3a, #img3b, #img3c'), { y: '-100%', duration: 0.5, stagger: 0.1 }, 'txt3+=0.1')
        .to(q('#txt1a'), { scale: 1.07 }, 'txt3+=0.3')
        .to(q('#txt3b'), { y: 0 }, 'txt3+=0.3')
        .to(q('#txt3c'), { y: 0 }, 'txt3+=0.5')
        .to(q('#txt3d'), { y: 0 }, 'txt3+=0.7')
        .to(q('#txt3e'), { opacity: 1 }, 'txt3b')
        .to(q('#legal-cta-button'), { opacity: 1 }, 'txt3b+=0.75')
        .to(q('#cta-hover-wrapper'), { opacity: 1, duration: 0.2 }, 'cta-=0.5')
        .to(q('#cta-button'), { scaleX: '100%', duration: 0.5 }, 'cta-=0.5')
        .to(q('#cta-text'), { opacity: 1 }, 'cta-=.25');
      return tl;
    }

    function showEndFrame() {
      gsap.set(q('.fromTop'), { y: 0, opacity: 1 });
      gsap.set(q('#txt1a'), { scale: 1.07 });
      gsap.set(q('#txt1b, #logo, #txt1c, #txt2'), { opacity: 0 });
      gsap.set(q('#img3a, #img3b, #img3c'), { y: '-100%' });
      gsap.set(q('#txt3b, #txt3c, #txt3d'), { y: 0 });
      gsap.set(q('#txt3e, #legal-cta-button, #cta-hover-wrapper, #cta-text'), { opacity: 1 });
      gsap.set(q('#cta-button'), { scaleX: '100%' });
    }

    const ctx = gsap.context(() => {
      const legal = gsap.timeline({ paused: true, defaults: { duration: 0.25, ease: 'power1.inOut' } });
      legal.to(q('#legal-overlay'), { top: 0 }, 'toggle');

      root.querySelector('[id="legal-cta-button"]')?.addEventListener('click', (event: Event) => {
        event.preventDefault();
        event.stopPropagation();
        legal.play();
      }, { signal: ac.signal });

      root.querySelector('[id="legal-close-button"]')?.addEventListener('click', (event: Event) => {
        event.preventDefault();
        event.stopPropagation();
        legal.reverse();
      }, { signal: ac.signal });

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        showEndFrame();
        return;
      }

      const master = gsap.timeline();
      master
        .add(frame1(), '0')
        .add(frame2(), '+=1.5')
        .add(frame3(), '+=1.5');
      master.repeat(-1);
      master.repeatDelay(2);
      master.eventCallback('onRepeat', () => {
        running.forEach((tl) => tl.kill());
        running.clear();
        resetBurst();
      });
    }, root);

    return () => {
      ac.abort();
      running.forEach((tl) => tl.kill());
      ctx.revert();
    };
  }

  function initAds() {
    document.querySelectorAll('[data-vw-ad]').forEach((root) => {
      if (!(root instanceof HTMLElement)) return;
      cleanups.get(root)?.();
      cleanups.set(root, mount(root));
    });
  }

  document.addEventListener('astro:page-load', initAds);
  document.addEventListener('astro:before-swap', () => {
    cleanups.forEach((cleanup) => cleanup());
    cleanups.clear();
  });
</script>

