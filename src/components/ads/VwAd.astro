            <style>
  /*  standard — scoped to the ad. html/body rules leak onto the page and lock scroll. */
  #container, #container div, #container a, #container img, #container button {
                margin:0;
                padding:0;
                border:0;
                font-size:100%;
                font:inherit;
                vertical-align:baseline;
              }
              div, img, button, svg {
                width: 100%;
                height: 100%;
                box-sizing: border-box;
                display: block;
                position: absolute;
                top: 0; left: 0;
                overflow:hidden;
              }

  /* The banner stays a 300×250 stage. Scale the whole stage to the slot so
     sprite coordinates and GSAP pixel offsets stay in sync. */
  [data-vw-ad] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    container-type: size;
  }
  #vw-link {
                cursor: pointer;
              }
        
  #vw-container {
                position:relative;
                overflow:hidden;
                width:300px;
                height:250px;
    transform-origin: top left;
    transform: scale(min(calc(100cqw / 300px), calc(100cqh / 250px)));
                background-color: #8bc481;
    line-height:1;
    font-family: system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue","Noto Sans","Liberation Sans",Arial,sans-serif,"Apple Color Emoji","Segoe UI Emoji","Segoe UI Symbol","Noto Color Emoji";
              }
  #vw-border {
                width: 100%;
                height: 100%;
                bottom: 0; right: 0;
                border: 1px solid #001e50;
                z-index: 100;
              }
              /* images */
              #img3a, #img3b, #img3c {
                top: 250px;
              }
              .svg-image,
              .svg-gradient {
                mix-blend-mode: multiply;
              }
        
              /* burst */
              #burst-wrapper {
                width: 117px;
                height: 117px;
              }
        
              /* other */
              .fromTop {
                top: 40px;
              }
              #txt1a-cropper { top: -200px;}
              #txt1a { top: 200px;}
              #txt1b-cropper { top: -175px;}
              #txt1b { top: 175px;}
        
              #txt2a-cropper { top: -205px;}
              #txt2a { top: 205px;}
              #txt2b-cropper { top: -170px;}
              #txt2b { top: 170px;}
        
              #txt3a-cropper { top: -205px;}
              #txt3a { top: 205px;}
              #txt3b-cropper { top: -176px;}
              #txt3b { top: 176px;}
              #txt3c-cropper { top: -155px;}
              #txt3c { top: 155px;}
              #txt3d-cropper { top: -142px;}
              #txt3d { top: 142px;}
        
              /*  text  */
              /* .sprite {
    background-image: url("/img/displayads/vw-sprite.svg");
                background-size: 3000px 3000px;
              } */
        
              #logo { background-position: 0 0; }
              #txt1a { background-position: -300px 0; }
              #txt1b { background-position: -600px 0; }
              #txt1c { background-position: -900px 0; }
              #txt2a { background-position: 0 -600px; }
              #txt2b { background-position: -300px -600px; }
              #txt3b { background-position: 0 -1200px; }
              #txt3c { background-position: -300px -1200px; }
              #txt3d { background-position: -600px -1200px; }
              #txt3e { background-position: -900px -1200px; }
              #cta-text { background-position: 0 -1800px; }
        
              /*  What starts out hidden  */
              #logo,#txt1a,#txt1b,#txt1c,#txt2a,#txt2b,
              #txt3a,#txt3b,#txt3c,#txt3d,#txt3e,
              #cta-hover-wrapper,#cta-text,#legal-cta-button {
                opacity:0;
              }
        
              /*  cta  */
              #cta-button {
                background-color: #ffffff;
                width: 120px;
                height: 35px;
                left: 28px;
                top: 155px;
                border-radius: 18px;
                transform-origin: 50% 50%;
              }
              /*  link hover effect  */
              #link #cta-hover-wrapper {
                transform-origin: 88px 173px;
                transition: transform 0.05s ease-in-out;
              }
              #link:hover #cta-hover-wrapper {
                transform: scale(0.97);
              }
        
              /*  legal  */
              .live-text {
                font-family: system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue","Noto Sans","Liberation Sans",Arial,sans-serif,"Apple Color Emoji","Segoe UI Emoji","Segoe UI Symbol","Noto Color Emoji";
              }
