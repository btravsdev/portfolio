---
import Icon from './Icon.astro';
import { profileLinks } from '../data/profileLinks';

interface Props {
  showColophonLink?: boolean;
}

const { showColophonLink = false } = Astro.props;

const contactLinks = [
  {
    href: 'tel:773-726-3263',
    icon: 'phone',
    iconTitle: 'generic phone icon',
    label: '773-726-3263',
  },
  {
    href: 'mailto:holler@briantravers.com',
    icon: 'email2',
    iconTitle: 'another generic email icon',
    label: 'holler@briantravers.com',
  },
] as const;
---

<footer class="section footer">
  <div class="footer__columns">
    <div class="footer__col">
      <h2 class="footer__heading">Contact</h2>
      <ul class="list-reset footer__list">
        {contactLinks.map((link) => (
          <li>
            <a class="additional-link footer__link" href={link.href}>
              <Icon name={link.icon} title={link.iconTitle} class="additional-link__svg" decorative />
              <span class="additional-link__text">{link.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer__col">
      <h2 class="footer__heading">Links</h2>
      <ul class="list-reset footer__list">
        {profileLinks.map((link) => (
          <li>
            <a class="additional-link footer__link" href={link.href}>
              <Icon name={link.icon} title={link.iconTitle} class="additional-link__svg" decorative />
              <span class="additional-link__text">{link.detail}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <p class="footer__copy"><small>&copy; Copyright 2026, Brian Travers</small></p>
  <!-- {showColophonLink && <p><small><a href="/colophon">Colophon</a></small></p>} -->
</footer>

<style lang="scss">
@use '../styles/breakpoints' as *;

.footer {
  background-color: var(--black);
  padding: var(--space-xl) var(--gap);
  color: var(--offwhite);
}

.footer__columns {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-lg);
  margin: 0 auto var(--space-xl);

  @include at-least(sm) {
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
  }
}

.footer__heading {
  margin: 0 0 var(--space-md);
  font-size: var(--font-size-h5);
  color: var(--offwhite);
}

.footer__list {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.footer__link {
  color: var(--offwhite);

  &:hover,
  &:focus-visible {
    color: var(--white);
    text-decoration: underline;
  }
}

.footer__copy {
  margin: 0;
  text-align: center;
  color: var(--offwhite);
}
</style>
