---
import WorkItem from './WorkItem.astro';
import DisplayAdsSection from '../ads/DisplayAdsSection.astro';
import Icon from '../Icon.astro';
import { workItems } from '../../data/workItems';
---

<section id="work" class="section-work section">
  <h2 class="section-hdr-hidden sr-only"><span>Selected Work</span></h2>
  <h3 id="work-past-launch-hdr" class="section-hdr" data-reveal="hdr-line"><span>Past launch</span></h3>
  <WorkItem {...workItems[0]} />

  <h3 id="work-scale-compliance-hdr" class="section-hdr" data-reveal="hdr-line"><span>Scale & Compliance</span></h3>
  <WorkItem {...workItems[1]} />

  <h3 id="work-motion-craft-hdr" class="section-hdr" data-reveal="hdr-line"><span>Motion & Craft</span></h3>
  <WorkItem {...workItems[2]} />

  <h3 id="work-every-kb-matters-hdr" class="section-hdr" data-reveal="hdr-line"><span>Every KB Matters</span></h3>
  <DisplayAdsSection />

  <p class="work-tinkering mix-blend-mode-multiply">
    See my pinned repos on
    <a
      class="link-chip"
      href="https://github.com/btravsdev"
      target="_blank"
      rel="noopener noreferrer"
    >
      GitHub
      <Icon name="external-link" decorative class="link-chip__icon" />
    </a>
    or
    <a
      class="link-chip"
      href="https://codepen.io/btravs"
      target="_blank"
      rel="noopener noreferrer"
    >
      CodePen
      <Icon name="external-link" decorative class="link-chip__icon" />
    </a>
    for recent tinkering.
  </p>
</section>


<style lang="scss" is:global>
.section-work .section-intro {
  max-width: var(--max-width-text);
  margin-bottom: var(--space-xl);
}

.work-tinkering {
  margin-top: var(--space-lg);
  max-width: var(--max-width-text);
  mix-blend-mode: multiply;
}

article {
  margin-bottom: 5rem;
}
</style>
