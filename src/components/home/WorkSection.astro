---
import WorkItem from './WorkItem.astro';
import DisplayAdsSection from '../ads/DisplayAdsSection.astro';
import { workItems } from '../../data/workItems';
---

<section id="work" class="section-work section">
  <h2 class="section-hdr" data-reveal="hdr-line"><span>Selected Work</span></h2>
  <p class="section-intro">
    Below are a few projects that highlight my approach to front-end engineering, CMS architecture, and interactive development.
  </p>

  {workItems.map((item) => <WorkItem {...item} />)}

  <DisplayAdsSection />

  <p class="work-tinkering">
    See my pinned repos on <a href="https://github.com/btravsdev">GitHub</a> or <a href="https://codepen.io/btravs">CodePen</a> for recent tinkering.
  </p>
</section>


<style lang="scss" is:global>
.section-work .section-intro {
  max-width: var(--max-width-text);
  margin-bottom: var(--space-xl);
}

.work-tinkering {
  margin-top: var(--space-lg);
  max-width: var(--max-width-text);
}

.header-links,
.header-links:visited {
  text-decoration: none;
  color: var(--black);
}
.header-links:hover {
  text-decoration: underline;
  color: var(--blue);
}

article {
  margin-bottom: 5rem;
}
</style>
