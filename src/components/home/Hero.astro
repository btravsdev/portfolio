---
import RoleChip from '../RoleChip.astro';
import { roles, roleList, type RoleId } from '../../data/roles';

interface Props {
  role?: RoleId;
}

const { role = 'developer' } = Astro.props;
const current = roles[role];
const otherRoles = roleList.filter((option) => option.id !== role);
---

<header class="site-header section">
  <h1 class="hero-copy hero-copy__title">Howdy, I'm Brian Travers.</h1>
  <div class="hero-copy hero-copy__intro-container">
    <p class="hero-copy hero-copy__intro">
      A Chicago-based
    </p>
    <div class="role-switcher">
      <RoleChip
        variant="dropdown"
        class="role-switcher__toggle"
        aria-expanded="false"
        aria-controls="role-switcher-menu"
        data-role-switcher-toggle
      >
        {current.label}
      </RoleChip>
      <n
        id="role-switcher-menu"
        class="role-switcher__menu"
        data-role-switcher-menu
        hidden
        aria-label="Other roles"
      >
        <ul class="role-switcher__list list-reset">
          {otherRoles.map((option) => (
            <li class="role-switcher__item" data-role-switcher-item>
              <RoleChip href={option.path} class="role-switcher__link">
                {option.label}
              </RoleChip>
            </li>
          ))}
        </ul>
      </n>
    </div>
    <p class="hero-copy hero-copy__intro">{Array.isArray(current.heroIntro) ? current.heroIntro.map((part) => typeof part === 'string' ? part : <RoleChip href={part.href}>{part.text}</RoleChip>) : ` ${current.heroIntro}`}</p>
  </div>
  {current.note && (
    <p class="hero-copy hero-copy__intro">
      <Fragment set:html={current.note} />
    </p>
  )}
</header>

<script>
  import { gsap } from 'gsap';

  let roleSwitcherAbort: AbortController | null = null;

  function prefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function bindRoleSwitcher() {
    roleSwitcherAbort?.abort();
    roleSwitcherAbort = new AbortController();
    const { signal } = roleSwitcherAbort;

    const toggle = document.querySelector('[data-role-switcher-toggle]');
    const menu = document.querySelector('[data-role-switcher-menu]');
    if (!(toggle instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;

    const items = Array.from(
      menu.querySelectorAll<HTMLElement>('[data-role-switcher-item]'),
    ).filter((item) => item.isConnected);

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;

      if (!items.length) return;

      if (prefersReducedMotion()) {
        gsap.set(items, { clearProps: 'all', opacity: open ? 1 : 0, y: 0 });
        return;
      }

      if (open) {
        gsap.fromTo(
          items,
          { opacity: 0, y: -8 },
          {
            opacity: 1,
            y: 0,
            duration: 0.28,
            stagger: 0.07,
            ease: 'power2.out',
            overwrite: true,
          },
        );
      } else {
        gsap.set(items, { opacity: 0, y: -8 });
      }
    };

    setOpen(false);

    toggle.addEventListener(
      'click',
      (event) => {
        event.stopPropagation();
        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
      },
      { signal },
    );

    document.addEventListener(
      'click',
      (event) => {
        if (toggle.getAttribute('aria-expanded') !== 'true') return;
        const target = event.target as Node;
        if (menu.contains(target) || toggle.contains(target)) return;
        setOpen(false);
      },
      { signal },
    );

    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key !== 'Escape') return;
        if (toggle.getAttribute('aria-expanded') !== 'true') return;
        setOpen(false);
        toggle.focus();
      },
      { signal },
    );
  }

  document.addEventListener('astro:before-swap', () => {
    roleSwitcherAbort?.abort();
    roleSwitcherAbort = null;
  });

  document.addEventListener('astro:page-load', bindRoleSwitcher);
</script>

<style lang="scss">
@use '../../styles/breakpoints' as *;

.site-header {
  padding-top: var(--space-3x);
  padding-bottom: var(--space-lg);

  @include at-least(md) {
    padding-bottom: var(--space-3x);
  }
}

.role-switcher {
  position: relative;
  display: inline-block;
  vertical-align: baseline;
}

.role-switcher__toggle {
  &[aria-expanded='true'] :global(.role-chip__icon) {
    transform: rotate(180deg);
  }

  :global(.role-chip__icon) {
    transition: transform 0.2s ease;

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }
}

.role-switcher__menu {
  position: absolute;
  top: calc(100% + 0.05em);
  left: 0;
  z-index: 25;
  min-width: max-content;
}

.role-switcher__list {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.05em;
}

.role-switcher__item {
  opacity: 0;
  font-size: 0.75em;
}

.role-switcher__link {
  display: inline-block;
  white-space: nowrap;
}
</style>
