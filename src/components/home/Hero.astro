---
import { roles, roleList, type RoleId } from '../../data/roles';

interface Props {
  role?: RoleId;
}

const { role = 'developer' } = Astro.props;
const current = roles[role];
---

<header class="site-header section">
  <div class="title-wrapper">
    <h1 class="title title__home">
      <span class="hello hello__home">Howdy, I'm</span>
      <span class="name name__home">Brian Travers</span>
    </h1>
  </div>
  <div class="intro intro__home">
    <p>
      a Chicago-based
      <label class="role-picker">
        <span class="sr-only">Choose a role</span>
        <select class="role-picker__select" name="role" data-role-picker>
          {roleList.map((option) => (
            <option value={option.path} selected={option.id === role}>
              {option.label}
            </option>
          ))}
        </select>
      </label>
      {current.blurb}
    </p>
    {current.note && (
      <p class="intro__note">
        <Fragment set:html={current.note} />
      </p>
    )}
  </div>
</header>

<script>
  import { navigate } from 'astro:transitions/client';

  function bindRolePicker() {
    const picker = document.querySelector('[data-role-picker]');
    if (!(picker instanceof HTMLSelectElement)) return;

    picker.onchange = () => {
      const next = picker.value;
      if (next && next !== window.location.pathname) {
        navigate(next);
      }
    };
  }

  document.addEventListener('astro:page-load', bindRolePicker);
</script>


<style lang="scss">
@use '../../styles/breakpoints' as *;

.site-header {
  padding-top: var(--space-2x);
  padding-bottom: var(--space-3x);
}
.intro {
  max-width: var(--max-width-text);
}
.intro__note {
  margin-top: var(--space-md);
}
.name__home { 
  @include at-least(md) {
    font-size: 6.5rem;
  }
  @include at-least(lg) {
    font-size: 8.5rem;
  }
  @include at-least(xl) {
    font-size: 11rem;
  }
  @include at-least(2x) {
    font-size: 15rem;
  }
}
</style>