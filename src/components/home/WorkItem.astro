---
interface WorkVideo {
  src: string;
  alt: string;
  poster: string;
}

interface WorkImage {
  href: string;
  src: string;
  alt: string;
}

interface Props {
  id: string;
  title: string;
  description: string;
  tags?: string[];
  link?: { href: string; label: string };
  video: WorkVideo;
  images?: WorkImage[];
}

const { id, title, description, tags = [], link, images = [], video } = Astro.props;
---

<article id={id} class="work-item">
  <div class="work-video-wrapper">
    <video
      class="work-video"
      src={video.src}
      poster={video.poster}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-label={video.alt}
      data-autoplay-video
    ></video>
    <button
      type="button"
      class="work-video-toggle"
      data-video-toggle
      aria-pressed="false"
      aria-label="Pause video"
    >
      <svg class="work-video-toggle__icon work-video-toggle__icon--pause" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <rect x="6" y="5" width="4" height="14" fill="currentColor" />
        <rect x="14" y="5" width="4" height="14" fill="currentColor" />
      </svg>
      <svg class="work-video-toggle__icon work-video-toggle__icon--play" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M8 5v14l11-7L8 5z" fill="currentColor" />
      </svg>
    </button>
  </div>
  <div class="work-item__content">
    <h3 class="work-hdr">{title}</h3>
    <p><Fragment set:html={description} /></p>
    {tags.length > 0 && (
      <ul class="work-tags list-reset" aria-label="Project tags">
        {tags.map((tag) => (
          <li class="work-tag">{tag}</li>
        ))}
      </ul>
    )}
    {link && (
      <p><strong>Link:</strong> <a href={link.href} class="work-link">{link.label}</a></p>
    )}
  </div>
  {images.length > 0 && (
    <div class="work-imgs">
      {images.map((image) => (
        <a class="work-img--link" href={image.href}><img class="work-img" src={image.src} alt={image.alt} /></a>
      ))}
    </div>
  )}
</article>

<script>
  function bindAutoplayVideos() {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll('[data-autoplay-video]:not([data-video-bound])').forEach((node) => {
      if (!(node instanceof HTMLVideoElement)) return;

      const wrapper = node.closest('.work-video-wrapper');
      const toggle = wrapper?.querySelector('[data-video-toggle]');
      if (!(toggle instanceof HTMLButtonElement)) return;

      node.setAttribute('data-video-bound', '');

      const setPausedState = (paused: boolean) => {
        toggle.setAttribute('aria-pressed', String(paused));
        toggle.setAttribute('aria-label', paused ? 'Play video' : 'Pause video');
      };

      if (reduceMotion) {
        node.removeAttribute('autoplay');
        node.pause();
        setPausedState(true);
      } else {
        node.play().catch(() => setPausedState(true));
        setPausedState(node.paused);
      }

      toggle.addEventListener('click', () => {
        if (node.paused) {
          node.play().catch(() => {});
          setPausedState(false);
        } else {
          node.pause();
          setPausedState(true);
        }
      });
    });
  }

  document.addEventListener('astro:page-load', bindAutoplayVideos);
</script>

<style lang="scss" is:global>
@use '../../styles/breakpoints' as *;

.work-item {
  display: flex;
  flex-direction: column;
  gap: var(--gap);
  padding-bottom: var(--gap);
  border-bottom: 1px solid var(--black);
  margin-bottom: calc(var(--gap) + 2px);

  @include at-least(md) {
    display: grid;
    grid-template-columns: 600px 1fr;
    gap: var(--gap);
  }
}

.work-imgs {
  display: grid;

  @include at-least(md) {
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
  }
}

.work-img {
  width: 100%;
  height: auto;
  border: 1px solid var(--blue);

  .work-img--link:hover & {
    border: 1px solid var(--green);
  }
}

.work-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin: 0 0 1rem;
}

.work-tag {
  padding: 0.2rem 0.55rem;
  border: 1px solid var(--black);
  background: transparent;
  color: var(--black);
  font-size: 0.75rem;
  line-height: 1.3;
  letter-spacing: 0.02em;
}

.work-video-wrapper {
  position: relative;
  width: 100%;
}

.work-video {
  display: block;
  width: 100%;
  height: auto;
  border: 1px solid var(--blue);
  background-color: var(--offwhite);
}

.work-video-toggle {
  position: absolute;
  right: 0.75rem;
  bottom: 0.75rem;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.25rem;
  height: 2.25rem;
  margin: 0;
  padding: 0;
  border: 1px solid var(--black);
  background: color-mix(in srgb, var(--offwhite) 90%, transparent);
  color: var(--black);
  cursor: pointer;

  &:hover,
  &:focus-visible {
    background: var(--white);
    outline: 2px solid var(--link-color);
    outline-offset: 2px;
  }

  .work-video-toggle__icon {
    display: block;
  }

  .work-video-toggle__icon--play {
    display: none;
  }

  &[aria-pressed='true'] {
    .work-video-toggle__icon--pause {
      display: none;
    }

    .work-video-toggle__icon--play {
      display: block;
    }
  }
}
</style>