---
import Icon from '../Icon.astro';

interface WorkVideo {
  src: string;
  alt: string;
  poster: string;
  captionsSrc?: string;
  caption?: string;
}

interface WorkImage {
  href: string;
  src: string;
  alt: string;
}

interface Props {
  id: string;
  title: string;
  description: string;
  tags?: string[];
  link?: { href: string; label: string };
  highlight?: string;
  video: WorkVideo;
  images?: WorkImage[];
}

const { id, title, description, tags = [], link, highlight, images = [], video } = Astro.props;
const captionId = `${id}-video-caption`;
---

<article id={id} class="work-item" data-reveal="work-item">
  <figure class="work-video-wrapper" data-reveal="work-video">
    <video
      class="work-video"
      src={video.src}
      poster={video.poster}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-label={video.alt}
      aria-describedby={video.caption ? captionId : undefined}
      data-autoplay-video
    >
      {video.captionsSrc && (
        <track
          kind="captions"
          srclang="en"
          label="English"
          src={video.captionsSrc}
        />
      )}
    </video>
    <button
      type="button"
      class="work-video-toggle"
      data-video-toggle
      data-video-label={title}
      aria-pressed="false"
      aria-label={`Pause video: ${title}`}
    >
      <svg class="work-video-toggle__icon work-video-toggle__icon--pause" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <rect x="6" y="5" width="4" height="14" fill="currentColor" />
        <rect x="14" y="5" width="4" height="14" fill="currentColor" />
      </svg>
      <svg class="work-video-toggle__icon work-video-toggle__icon--play" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M8 5v14l11-7L8 5z" fill="currentColor" />
      </svg>
    </button>
    {video.caption && (
      <figcaption id={captionId} class="work-video__caption sr-only">
        {video.caption}
      </figcaption>
    )}
  </figure>
  {images.length > 0 && (
    <div class="work-imgs" data-reveal="work-images">
      {images.map((image) => (
        <a class="work-img--link" href={image.href} data-reveal="work-image"><img class="work-img" src={image.src} alt={image.alt} /></a>
      ))}
    </div>
  )}
  <div class="work-item__content" data-reveal="work-content">
    <h3 class="work-hdr">
      <span class="work-hdr__title">{title}</span>
      {link && (
        <a
          class="work-hdr__link"
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          title={link.href}
          aria-label={`Visit ${link.label} (opens in a new tab)`}
        >
          <Icon name="external-link" decorative class="work-hdr__link-icon" />
        </a>
      )}
    </h3>
    <p class="work-item__description"><Fragment set:html={description} /></p>
    {highlight && (
      <p class="work-item__highlight"><strong>HIGHLIGHT:</strong> {highlight}</p>
    )}
    {tags.length > 0 && (
      <ul class="work-tags list-reset" aria-label="Project tags">
        {tags.map((tag) => (
          <li class="work-tag">{tag}</li>
        ))}
      </ul>
    )}
  </div>
</article>

<script>
  function bindAutoplayVideos() {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll('[data-autoplay-video]:not([data-video-bound])').forEach((node) => {
      if (!(node instanceof HTMLVideoElement)) return;

      const wrapper = node.closest('.work-video-wrapper');
      const toggle = wrapper?.querySelector('[data-video-toggle]');
      if (!(toggle instanceof HTMLButtonElement)) return;

      node.setAttribute('data-video-bound', '');

      // Keep caption tracks available but not shown as an on-video overlay by default
      Array.from(node.textTracks).forEach((track) => {
        track.mode = 'hidden';
      });

      const videoName = toggle.dataset.videoLabel || 'video';

      const setPausedState = (paused: boolean) => {
        toggle.setAttribute('aria-pressed', String(paused));
        toggle.setAttribute(
          'aria-label',
          paused ? `Play video: ${videoName}` : `Pause video: ${videoName}`,
        );
      };

      if (reduceMotion) {
        node.removeAttribute('autoplay');
        node.pause();
        setPausedState(true);
      } else {
        node.play().catch(() => setPausedState(true));
        setPausedState(node.paused);
      }

      toggle.addEventListener('click', () => {
        if (node.paused) {
          node.play().catch(() => {});
          setPausedState(false);
        } else {
          node.pause();
          setPausedState(true);
        }
      });
    });
  }

  document.addEventListener('astro:page-load', bindAutoplayVideos);
</script>

<style lang="scss" is:global>
@use '../../styles/breakpoints' as *;

.work-item {
  display: flex;
  flex-direction: column;
  gap: var(--gap);
  padding-bottom: var(--space-2x);
  border-bottom: 1px solid var(--text-color);
  margin-bottom: calc(var(--space-2x) + 2px);

  &:last-of-type {
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  @include at-least(md) {
    display: grid;
    grid-template-columns: var(--max-width-focus) 1fr;
    grid-template-areas: 'video content'
    'imgs content';
    gap: var(--gap);
  }
}

.work-item__content {
  @include at-least(md) {
    grid-area: content;
    position: sticky;
    top: 0;
    height: fit-content;
  }

  @include at-least(lg) {
    padding-left: var(--space-lg);
  }
}

.work-hdr {
  display: flex;
  align-items: center;
  gap: 0.4em;
  margin-bottom: var(--space-sm);
}

.work-item__description {
  max-width: var(--max-width-text);
}

.work-hdr__link {
  display: inline-flex;
  flex-shrink: 0;
  color: var(--link-color);
  line-height: 0;

  &:hover,
  &:focus-visible {
    color: var(--link-color-hover);
  }
}

.work-hdr__link-icon {
  display: block;
  width: 0.7em;
  height: 0.7em;
}

.work-item__highlight {
  margin: var(--space-lg) 0 0;
}

.work-imgs {
  display: grid;

  @include at-least(md) {
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
    grid-area: imgs;
  }
}

.work-img {
  width: 100%;
  height: auto;
  border: 1px solid var(--blue);

  .work-img--link:hover & {
    border: 1px solid var(--green);
  }
}

.work-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin: 0 0 1rem;
}

.work-tag {
  padding: 0.2rem 0.55rem;
  border: 1px solid var(--text-color);
  background: transparent;
  color: var(--text-color);
  font-size: 0.75rem;
  line-height: 1.3;
  letter-spacing: 0.02em;
}

.work-video-wrapper {
  grid-area: video;
  position: relative;
  width: 100%;
  margin: 0;
}

.work-video {
  display: block;
  width: 100%;
  height: auto;
  border: 1px solid var(--blue);
  background-color: var(--offwhite);
}

.work-video-toggle {
  position: absolute;
  right: 0.75rem;
  bottom: 0.75rem;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.25rem;
  height: 2.25rem;
  margin: 0;
  padding: 0;
  border: 1px solid var(--black);
  background: color-mix(in srgb, var(--offwhite) 90%, transparent);
  color: var(--black);
  cursor: pointer;

  body.dark-theme & {
    border-color: var(--offwhite);
    background: color-mix(in srgb, var(--black) 85%, transparent);
    color: var(--offwhite);
  }

  &:hover,
  &:focus-visible {
    background: var(--white);
    outline: 2px solid var(--link-color);
    outline-offset: 2px;
  }

  .work-video-toggle__icon {
    display: block;
  }

  .work-video-toggle__icon--play {
    display: none;
  }

  &[aria-pressed='true'] {
    .work-video-toggle__icon--pause {
      display: none;
    }

    .work-video-toggle__icon--play {
      display: block;
    }
  }
}
</style>