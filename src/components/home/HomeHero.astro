---
import RoleChipRotates from '../RoleChipRotates.astro';
import { roles } from '../../data/roles';
---

<header class="site-header section" data-home-hero>
  <h1 class="hero-copy hero-copy__title"><span>Howdy,</span> <span>I'm</span> <span>Brian</span> <span>Travers,<br>
    <span>a</span> <span><RoleChipRotates href={roles.developer.path} /></span>
  </h1>
</header>

<script>
  import { gsap } from 'gsap';

  let reveal: gsap.core.Timeline | null = null;
  let run = 0;

  function clearHeroReveal() {
    run += 1;
    reveal?.kill();
    reveal = null;
  }

  async function revealHeroCopy() {
    clearHeroReveal();
    const id = run;

    const root = document.querySelector('[data-home-hero]');
    if (!(root instanceof HTMLElement)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    await document.fonts.ready;
    if (id !== run || !root.isConnected) return;

    const startOpacity = 0.25;
    const endOpacity = 1;
    const targets = [...root.querySelectorAll<HTMLElement>('.hero-copy > span')];
    if (!targets.length) return;

    reveal = gsap.timeline({
      onComplete() {
        root.querySelectorAll('.hero-copy').forEach((el) => {
          el.classList.add('is-revealed');
        });
        gsap.set(targets, { clearProps: 'color' });
      },
    }).fromTo(
      targets,
      { opacity: startOpacity },
      {
        opacity: endOpacity,
        duration: 0.25,
        ease: 'power2.out',
        stagger: 0.25,
        delay: .25,
      },
    );
  }

  document.addEventListener('astro:page-load', () => {
    void revealHeroCopy();
  });

  document.addEventListener('astro:before-swap', clearHeroReveal);
</script>

<style lang="scss">
@use '../../styles/breakpoints' as *;

.site-header {
  padding-top: var(--space-3x);
  padding-bottom: var(--space-lg);
  line-height: 1.25;
  font-size: clamp(1.5rem, 3.5vw + 0.75rem, 2.75rem);

  @include at-least(md) {
    line-height: 1.1;
    font-size: clamp(1.75rem, 2.8vw + 0.5rem, 3.25rem);
    padding-bottom: var(--space-3x);
  }

  @include at-least(lg) {
    font-size: clamp(2rem, 2.2vw + 0.75rem, 3.5rem);
  }
}

.hero-copy {
  font-size: inherit;
  line-height: inherit;

  &.is-revealed {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    color: var(--text-color);
  }
}
</style>
