---
import { jobs } from '../../data/jobs';
---

<section id="experience" class="section section-experience">
  <h2 class="section-hdr" data-reveal="hdr-line"><span>Experience</span></h2>

  <ol class="experience-list list-reset">
    {jobs.map((job) => (
      <li id={job.id} class="experience-item" data-reveal="experience-item">
        <h3 class="experience-item__header">
          <span class="experience-item__company">{job.company}</span>
          <span class="experience-item__dates">{job.dates}</span>
        </h3>
        <p class="experience-item__title">{job.title}</p>
        <p class="experience-item__description">{job.description}</p>
        {job.bulletPoints && job.bulletPoints.length > 0 && (
          <ul class="experience-item__bullets list-reset">
            {job.bulletPoints.map((point) => (
              <li>
                <Fragment set:html={point} />
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ol>
</section>

<style lang="scss">
@use '../../styles/breakpoints' as *;

.experience-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-xl);
}

.experience-item__header {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin: 0 0 var(--space-xs);
  line-height: 1;
}

.experience-item__company {
  font-size: var(--font-size-h3);
}

.experience-item__dates {
  font-size: var(--font-size-normal);
  font-weight: var(--weight-normal);
}

.experience-item__title {
  font-size: var(--font-size-h5);
  font-weight: var(--weight-normal);
}

.experience-item__description {
  margin: 0;
  max-width: var(--max-width-text);
}

.experience-item__bullets {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  margin: var(--space-lg) 0 0;
  max-width: var(--max-width-text);
}

.experience-item__bullets li {
  position: relative;
  padding-left: 1.75rem;
  line-height: 1.45;

  &::before {
    content: '';
    position: absolute;
    top: 0.2em;
    left: 0;
    width: 1.1rem;
    height: 0.825rem;
    background-color: currentColor;
    mask: url('/img/bt-logo.svg') center / contain no-repeat;
    -webkit-mask: url('/img/bt-logo.svg') center / contain no-repeat;
  }
}
</style>
