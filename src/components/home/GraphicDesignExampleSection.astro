---
import WorkItem from './WorkItem.astro';

const examples = [
  {
    id: 'cyc-logo',
    title: 'Continental Youth Championships',
    description:
      '<strong>Description:</strong> Logo and collateral created for an annual nationwide youth Gaelic football and hurling tournament held in Chicago in&nbsp;2022.',
    video: {
      src: '/video/cyc2022.mp4',
      poster: '/video/cyc2022.jpg',
      alt: 'Video of Continental Youth Championships logo and collateral',
    },
  },
  {
    id: 'havemercy-logo',
    title: 'Mercy Home',
    description: '<strong>Description:</strong> Logo for annual Mercy Home for Boys and Girls benefit.',
    video: {
      src: '/video/havemercy.mp4',
      poster: '/video/havemercy.jpg',
      alt: 'Video of Mercy Home logo',
    },
  },
  {
    id: 'tread365-logo',
    title: 'Tread 365',
    description: '<strong>Description:</strong> Identity for Chicago-based swim and water polo apparel company.',
    video: {
      src: '/video/tread365.mp4',
      poster: '/video/tread365.jpg',
      alt: 'Video of Tread 365 identity',
    },
  },
];
---

<section id="branding" class="section-work section">
  <h2 class="section-hdr"><span>Branding</span></h2>

  {examples.map((item) => <WorkItem {...item} />)}
</section>
