---
import Icon from '../Icon.astro';

interface SkillIcon {
  name: string;
  title: string;
}

interface SkillSet {
  title: string;
  icons?: SkillIcon[];
  skills: string[];
}

const skillSets: SkillSet[] = [
  {
    title: 'Core Skills',
    icons: [
      { name: 'html5', title: 'HTML5 icon' },
      { name: 'sass', title: 'SASS icon' },
      { name: 'javascript', title: 'JavaScript icon' },
      { name: 'svg', title: 'SVG icon' },
    ],
    skills: ['HTML', 'CSS/SCSS', 'JavaScript', 'TypeScript', 'SVG'],
  },
  {
    title: 'Recent Frameworks',
    icons: [
      { name: 'react', title: 'React icon' },
      { name: 'nextjs', title: 'Next.js icon' },
      { name: 'vue', title: 'Vue icon' },
      { name: 'astro', title: 'Astro icon' },
    ],
    skills: ['React', 'Next.js', 'Vue', 'Nuxt', 'Astro'],
  },
  {
    title: 'CMS',
    icons: [
      { name: 'wordpress', title: 'WordPress logo' },
      { name: 'php', title: 'PHP logo' },
      { name: 'laravel', title: 'Laravel icon' },
      { name: 'squarespace', title: 'Squarespace logo' },
    ],
    skills: ['Sanity', 'Contentful', 'WordPress', 'PHP / Laravel', 'Squarespace'],
  },
  {
    title: 'Development Tools',
    icons: [
      { name: 'figma', title: 'Figma icon' },
      { name: 'cursor', title: 'Cursor AI icon' },
      { name: 'claude', title: 'Claude Code icon' },
      { name: 'github', title: 'GitHub icon' },
    ],
    skills: ['Git', 'Figma', 'Cursor', 'Claude Code'],
  },
  {
    title: 'Additional Skills',
    icons: [
      { name: 'gsap', title: 'GSAP icon' },
      { name: 'ae', title: 'After Effects icon' },
      { name: 'adobe', title: 'Adobe Creative Suite icon' },
      { name: 'css', title: 'CSS animation icon' },
    ],
    skills: [
      'HTML Email Development',
      'Display Advertising',
      'Motion Graphics',
      'After Effects',
      'Adobe Illustrator',
    ],
  },
];
---

<section id="skills" class="section section-skills gridder">
  <h2 id="skills-hdr" class="section-hdr" data-reveal="hdr-line"><span>Approach</span></h2>

  <ul class="skill-content-list">
    <li>
      I build modern web applications with a thoughtful combination of hand-written and AI-assisted code, focusing on scalable architecture, reusable components, and maintainable front-end systems.
    </li>
    <li>
      I enjoy owning products beyond launch—evolving CMS platforms (like Sanity and Contentful), integrating APIs, improving publishing workflows, and partnering with designers, marketers, and stakeholders to continually improve the user experience.
    </li>
  </ul>

  <div id="skill-sets" class="skill-sets" data-reveal="skill-sets">
    {skillSets.map((set) => (
      <div class="skill-set" data-reveal="skill-set">
        <h3 class="skill-set-hdr"><span>{set.title}</span></h3>
        <div class="skills-wrapper">
          <div class="skill-icons">
            <div class="skill-icons-wrapper">
              {set.icons && set.icons.length > 0 && set.icons.map((icon) => (
                <div class="skill-icon">
                  <Icon name={icon.name} title={icon.title} decorative />
                </div>
              ))}
            </div>
          </div>
          <ul class="skill-list list-reset">
            {set.skills.map((skill) => (
              <li>
                <span class="skill-name">{skill}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>

<style lang="scss">
@use '../../styles/breakpoints.scss' as *;

.skill-content-list {
  margin-bottom: var(--space-xl);
  list-style: square;
  padding-left: var(--space-md);
  max-width: var(--max-width-text);

  li {
    margin-bottom: var(--space-md);
  }
}
.skill-sets {
  padding-left: var(--space-md);
  @include at-least(sm) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
  }

  @include at-least(md) {
    grid-template-columns: 1fr 1fr 1fr;
  }
}

.skills-wrapper {
  --icon-size: var(--space-lg);
  --icon-gap: var(--space-xs);

  display: grid;
  grid-template-columns: calc(var(--icon-size) * 2 + var(--icon-gap)) 1fr;
  gap: var(--gap);
}
.skill-icons-wrapper {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--icon-gap);
}
.skill-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}
.skill-svg {
  width: var(--icon-size);
  height: var(--icon-size);
}

.set {
  margin-bottom: var(--space-2x);

  & + .set {
    margin-bottom: 0;
  }
}
.skill-set-hdr {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-xs);
  margin-bottom: var(--space-md);

  span{
    font-size: var(--font-size-h5);
    white-space: nowrap;
  }
  &::after {
    content: '';
    display: block;
    width: 100%;
    height: 0.9rem;
    background-color: var(--text-color);
    margin-top: var(--space-xs);
  }
}
</style>
