---
import Icon from '../Icon.astro';
---

<section id="skills" class="section section-skills gridder">
  <h2 id="skills-hdr" class="section-hdr"><span>Skills</span></h2>

  <div id="skill-sets" class="skill-sets gridder">
    <div class="skill-set">
      <h3 class="skill-set-hdr sr-only">Fundamentals:</h3>
      <ul class="skill-list">
        <li>
          <div class="skill-icons">
            <Icon name="html5" title="HTML5 Icon" />
          </div>
          <div class="skill">HTML</div>
        </li>
        <li>
          <div class="skill-icons">
            <Icon name="css" title="CSS Icon" />
          </div>
          <div class="skill">CSS/Sass</div>
        </li>
        <li>
          <div class="skill-icons">
            <Icon name="javascript" title="Javascript Icon" />
          </div>
          <div class="skill">Javscript</div>
        </li>
        <li>
          <div class="skill-icons">
            <Icon name="svg" title="SVG Icon" />
          </div>
          <div class="skill">SVG</div>
        </li>
        <li>
          <div class="skill-icons">
            <Icon name="wordpress" title="Wordpress Logo" />
          </div>
          <div class="skill">Wordpress</div>
        </li>
        <li>
          <div class="skill-icons">
            <Icon name="a11y" title="Logo icon for A11y Project" />
          </div>
          <div class="skill">Accessibility (A11Y)</div>
        </li>
        <li>
          <div class="skill-icons">
            <Icon name="email1" title="Generic email icon" />
          </div>
          <div class="skill">HTML Email</div>
        </li>
      </ul>
    </div>

    <div class="skill-set">
      <h4 class="skill-set-hdr sr-only">Notable experience:</h4>
      <ul class="skill-list">
        <li>
          <div class="skill-icons">
            <Icon name="react" title="React Icon" />
            <Icon name="vue" title="Vue Icon" />
          </div>
          <div class="skill">JS Frameworks <span class="skill-example">(React, Vue)</span></div>
        </li>
        <li>
          <div class="skill-icons">
            <Icon name="php" title="Php logo" />
            <Icon name="laravel" title="Laravel icon" />
          </div>
          <div class="skill">PHP <span class="skill-example">(Laravel)</span></div>
        </li>
        <li>
          <div class="skill-icons">
            <Icon name="gatsby" title="Gatsby JS icon" />
            <Icon name="jeckyll" title="Jeckyll logo" />
          </div>
          <div class="skill">Static Site Generators <span class="skill-example">(Gatsby and Jekyll)</span></div>
        </li>
        <li>
          <div class="skill-icons">
            <Icon name="drupal" title="Drupal Icon" />
            <Icon name="squarespace" title="Squarespace Icon" />
          </div>
          <div class="skill">Other CMS's <span class="skill-example">(Drupal 7, Squarespace, Wix, etc)</span></div>
        </li>
        <li>
          <div class="skill-icons">
            <Icon name="github" title="Github Icon" />
            <Icon name="digital-ocean" title="Digital Ocean logo" />
          </div>
          <div class="skill">Backend <span class="skill-example">(version control, basic setup &amp; maintenance)</span></div>
        </li>
      </ul>
    </div>
  </div>
</section>
